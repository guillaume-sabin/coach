{
  "name": "coach",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api": "npm run dev -w @coach/api",
    "web": "npm run web -w @coach/mobile",
    "db:push": "npm run db:push -w @coach/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile=reports/vitest-junit.xml",
    "test:swift": "powershell -File apps/ios/CoachCore/test.ps1 --parallel"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "vitest": "^3.2.7"
  }
}
